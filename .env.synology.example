# Copy this file to .env on the NAS, then replace every replace-with-* value.
# Keep this file free of real passwords and API keys.

# App
NEXT_PUBLIC_APP_URL=https://erp.kuda.synology.me
APP_ENV=production

# Database
POSTGRES_IMAGE=postgres:16.14-alpine
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-url-safe-db-password
POSTGRES_DB=kudalabs_erp
DATABASE_URL=postgresql://erp:replace-with-url-safe-db-password@db:5432/kudalabs_erp?schema=public

# Redis / queue
REDIS_IMAGE=redis:7.4.7-alpine
REDIS_URL=redis://redis:6379

# Auth
AUTH_SECRET=replace-with-long-random-secret
AUTH_COOKIE_SECURE=true
ADMIN_EMAIL=replace-with-admin-email
ADMIN_NAME=시스템 관리자
ADMIN_PASSWORD=replace-with-12-or-more-character-password
ADMIN_ROLE=ADMIN

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Google AI Studio / Gemini Vision (명함·영수증·회의 전사)
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=45000

# Tax invoice integration
TAX_INVOICE_PROVIDER=barobill
BAROBILL_API_URL=https://testws.baroservice.com/TI.asmx
BAROBILL_TIMEOUT_MS=30000
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
BAROBILL_CERT_KEY=
BAROBILL_CORP_NUM=replace-with-supplier-business-number
BAROBILL_INVOICER_CONTACT_ID=replace-with-barobill-member-id
TAX_INVOICE_SUPPLIER_CORP_NUM=replace-with-supplier-business-number
TAX_INVOICE_SUPPLIER_TAX_REG_ID=
TAX_INVOICE_SUPPLIER_NAME=replace-with-supplier-name
TAX_INVOICE_SUPPLIER_CEO_NAME=replace-with-ceo-name
TAX_INVOICE_SUPPLIER_ADDRESS=replace-with-business-address
TAX_INVOICE_SUPPLIER_BIZ_CLASS=
TAX_INVOICE_SUPPLIER_BIZ_TYPE=
TAX_INVOICE_SUPPLIER_CONTACT_NAME=
TAX_INVOICE_SUPPLIER_TEL=
TAX_INVOICE_SUPPLIER_HP=
TAX_INVOICE_SUPPLIER_EMAIL=

# File storage
UPLOAD_DIR=/app/uploads
