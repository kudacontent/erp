# Safe template for Synology. Copy to .env and replace every placeholder.
NEXT_PUBLIC_APP_URL=https://erp.example.com
APP_ENV=production

POSTGRES_IMAGE=postgres:16.14-alpine
REDIS_IMAGE=redis:7.4.7-alpine
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=kudalabs_erp
DATABASE_URL=postgresql://erp:replace-with-a-long-random-database-password@db:5432/kudalabs_erp?schema=public
REDIS_URL=redis://redis:6379

AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_SECURE=true
ADMIN_EMAIL=kuda_content@gmail.com
ADMIN_NAME=kuda
ADMIN_PASSWORD=***REMOVED***
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TAX_INVOICE_PROVIDER=mock
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
BAROBILL_CERT_KEY=
UPLOAD_DIR=/app/uploads
