# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Database
POSTGRES_IMAGE=postgres:16.14-alpine
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kudalabs_erp
DATABASE_URL=postgresql://erp:change-me@db:5432/kudalabs_erp?schema=public

# Redis / queue
REDIS_IMAGE=redis:7.4.7-alpine
REDIS_URL=redis://redis:6379

# Auth
AUTH_SECRET=replace-with-long-random-secret
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=시스템 관리자
ADMIN_PASSWORD=replace-with-a-long-random-password

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tax invoice integration
TAX_INVOICE_PROVIDER=mock
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
BAROBILL_CERT_KEY=

# File storage
UPLOAD_DIR=/app/uploads
