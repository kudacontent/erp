generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CEO
  ADMIN
  OPERATIONS
  ACCOUNTING
  HR
  EMPLOYEE
  AUDITOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClientType {
  CLIENT
  SHIP_OWNER
  PARTNER
  SUPPLIER
  MAINTENANCE
  ACCOUNTING_TAX
  PROSPECT
  OTHER
}

enum ContractStatus {
  DRAFT
  SIGNED
  BILLING_PENDING
  BILLING_DONE
  PAYMENT_PENDING
  PARTIAL_PAYMENT
  PAID
  CLOSED
  CANCELED
}

enum BillingStatus {
  PENDING
  ISSUED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ApprovalStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum MeetingStatus {
  SCHEDULED
  DONE
  MINUTES_DRAFT
  FOLLOW_UP
  COMPLETED
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String?      @map("password_hash")
  role         UserRole     @default(EMPLOYEE)
  status       RecordStatus @default(ACTIVE)
  employeeId   String?
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  expenses     Expense[]    @relation("ExpenseCreatedBy")
  approvals    Expense[]    @relation("ExpenseApprovedBy")
  meetings     Meeting[]
  actionItems  ActionItem[]
  auditLogs    AuditLog[]
  notifications Notification[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Employee {
  id          String       @id @default(uuid())
  name        String
  role        String
  department  String?
  baseSalary  BigInt?
  joinedAt    DateTime
  resignedAt  DateTime?
  status      RecordStatus @default(ACTIVE)
  phone       String?
  email       String?
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Client {
  id             String           @id @default(uuid())
  name           String
  clientType     ClientType       @default(OTHER)
  businessNumber String?
  ceoName        String?
  phone          String?
  email          String?
  address        String?
  website        String?
  memo           String?
  tags           Json?
  contacts       ClientContact[]
  contracts      ProjectContract[]
  expenses       Expense[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ClientContact {
  id                   String   @id @default(uuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                 String
  position             String?
  department           String?
  mobile               String?
  phone                String?
  email                String?
  businessCardImageUrl String?
  ocrRawText           String?
  ocrConfidence        Decimal?
  memo                 String?
  meetingAttendees     MeetingAttendee[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ProjectContract {
  id             String           @id @default(uuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  projectTitle   String
  contractAmount BigInt
  vatAmount      BigInt
  totalAmount    BigInt
  billingStatus  BillingStatus    @default(PENDING)
  paymentStatus  PaymentStatus    @default(UNPAID)
  contractStatus ContractStatus   @default(DRAFT)
  contractedAt   DateTime?
  dueDate        DateTime?
  closedAt       DateTime?
  memo           String?
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Expense {
  id               String         @id @default(uuid())
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id])
  expenseCategory   String
  amount            BigInt
  vatAmount         BigInt         @default(0)
  totalAmount       BigInt
  paymentMethod     String
  approvalStatus    ApprovalStatus @default(DRAFT)
  receiptImageUrl   String?
  geminiAnalysis    String?
  spentAt           DateTime
  createdById       String?
  createdBy         User?          @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedById      String?
  approvedBy        User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Meeting {
  id              String            @id @default(uuid())
  title           String
  meetingType     String
  status          MeetingStatus     @default(SCHEDULED)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id])
  contractId      String?
  contract        ProjectContract?  @relation(fields: [contractId], references: [id])
  calendarEventId String?           @unique
  calendarEvent   CalendarEvent?    @relation(fields: [calendarEventId], references: [id])
  location        String?
  startedAt       DateTime
  endedAt         DateTime?
  agenda          String?
  minutes         String?
  geminiSummary   String?
  createdById     String?
  createdBy       User?             @relation(fields: [createdById], references: [id])
  attendees       MeetingAttendee[]
  actionItems     ActionItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MeetingAttendee {
  id           String         @id @default(uuid())
  meetingId    String
  meeting      Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String?
  contactId    String?
  contact      ClientContact? @relation(fields: [contactId], references: [id])
  attendeeName String?
  attendeeType String
}

model ActionItem {
  id          String       @id @default(uuid())
  meetingId   String?
  meeting     Meeting?     @relation(fields: [meetingId], references: [id])
  title       String
  description String?
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id])
  dueDate     DateTime?
  status      ActionStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CalendarEvent {
  id            String            @id @default(uuid())
  googleEventId String?           @unique
  title         String
  category      String
  clientId      String?
  client        Client?           @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      ProjectContract?  @relation(fields: [contractId], references: [id])
  meeting       Meeting?
  startTime     DateTime
  endTime       DateTime
  description   String?
  syncStatus    String            @default("LOCAL_ONLY")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Attachment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String?
  fileSize   BigInt?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model DailyManagementReport {
  id             String   @id @default(uuid())
  reportDate     DateTime @unique
  geminiBriefing String
  sourceSnapshot Json?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Notification {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  body             String
  notificationType String
  targetUrl        String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
}
