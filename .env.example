# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Database
POSTGRES_IMAGE=postgres:16.14-alpine
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kudalabs_erp
DATABASE_URL=postgresql://erp:change-me@db:5432/kudalabs_erp?schema=public

# Redis / queue
REDIS_IMAGE=redis:7.4.7-alpine
REDIS_URL=redis://redis:6379

# Auth
AUTH_SECRET=replace-with-long-random-secret
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=시스템 관리자
ADMIN_PASSWORD=replace-with-a-long-random-password
# Set to CEO once to promote the bootstrap account to the CEO role.
ADMIN_ROLE=ADMIN
# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ACCOUNT=kuda.content@gmail.com
# Leave blank to derive from NEXT_PUBLIC_APP_URL.
GOOGLE_CALENDAR_REDIRECT_URI=
# Tokens are encrypted at rest. If blank, AUTH_SECRET is used as the key source.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Google AI Studio / Gemini Vision (명함·영수증·회의 전사)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: timeout for one Gemini request in milliseconds
GEMINI_TIMEOUT_MS=45000

# Tax invoice integration
TAX_INVOICE_PROVIDER=mock
BAROBILL_API_URL=https://testws.baroservice.com/TI.asmx
BAROBILL_TIMEOUT_MS=30000
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
BAROBILL_CERT_KEY=
BAROBILL_CORP_NUM=
BAROBILL_INVOICER_CONTACT_ID=
TAX_INVOICE_SUPPLIER_CORP_NUM=
TAX_INVOICE_SUPPLIER_TAX_REG_ID=
TAX_INVOICE_SUPPLIER_NAME=
TAX_INVOICE_SUPPLIER_CEO_NAME=
TAX_INVOICE_SUPPLIER_ADDRESS=
TAX_INVOICE_SUPPLIER_BIZ_CLASS=
TAX_INVOICE_SUPPLIER_BIZ_TYPE=
TAX_INVOICE_SUPPLIER_CONTACT_NAME=
TAX_INVOICE_SUPPLIER_TEL=
TAX_INVOICE_SUPPLIER_HP=
TAX_INVOICE_SUPPLIER_EMAIL=

# File storage
UPLOAD_DIR=/app/uploads

# 개발 단계 전용: 최고관리자(CEO)에게 강제 삭제 권한을 준다.
# 평소 이 ERP 는 회계 기록을 지우지 않고 취소·보관 처리만 한다.
# 이 값이 true 일 때만 계약·견적·지출·세금계산서·거래처·직원을 실제로 삭제할 수 있고,
# 관리자 화면에 '테스트 데이터 정리' 카드가 나타난다.
# ※ 운영 전환 시 이 줄을 지우거나 false 로 둘 것. 값이 없으면 기능은 닫혀 있다.
ALLOW_HARD_DELETE=false

# 회의 녹음 업로드 상한 (MB). 비우거나 0 이면 상한 없음.
# 업로드는 메모리가 아니라 디스크로 바로 흘러가므로 파일이 커져도 메모리는 일정하다.
# 실수로 볼륨을 채우는 것을 막고 싶을 때만 값을 넣는다. 예: 2000
MEETING_UPLOAD_MAX_MB=
