# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Database
POSTGRES_IMAGE=postgres:16.14-alpine
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kudalabs_erp
DATABASE_URL=postgresql://erp:change-me@db:5432/kudalabs_erp?schema=public

# Redis / queue
REDIS_IMAGE=redis:7.4.7-alpine
REDIS_URL=redis://redis:6379

# Auth
AUTH_SECRET=replace-with-long-random-secret
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=kuda_content@gmail.com
ADMIN_NAME=시스템 관리자
ADMIN_PASSWORD=***REMOVED***
# Set to CEO once to promote the bootstrap account to the CEO role.
ADMIN_ROLE=ADMIN
# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Google AI Studio / Gemini Vision (명함·영수증·회의 전사)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: timeout for one Gemini request in milliseconds
GEMINI_TIMEOUT_MS=45000

# Tax invoice integration
TAX_INVOICE_PROVIDER=mock
BAROBILL_API_URL=https://testws.baroservice.com/TI.asmx
BAROBILL_TIMEOUT_MS=30000
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
BAROBILL_CERT_KEY=
BAROBILL_CORP_NUM=
BAROBILL_INVOICER_CONTACT_ID=
TAX_INVOICE_SUPPLIER_CORP_NUM=
TAX_INVOICE_SUPPLIER_TAX_REG_ID=
TAX_INVOICE_SUPPLIER_NAME=
TAX_INVOICE_SUPPLIER_CEO_NAME=
TAX_INVOICE_SUPPLIER_ADDRESS=
TAX_INVOICE_SUPPLIER_BIZ_CLASS=
TAX_INVOICE_SUPPLIER_BIZ_TYPE=
TAX_INVOICE_SUPPLIER_CONTACT_NAME=
TAX_INVOICE_SUPPLIER_TEL=
TAX_INVOICE_SUPPLIER_HP=
TAX_INVOICE_SUPPLIER_EMAIL=

# File storage
UPLOAD_DIR=/app/uploads
