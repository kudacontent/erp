generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CEO
  ADMIN
  OPERATIONS
  ACCOUNTING
  HR
  EMPLOYEE
  AUDITOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClientType {
  CLIENT
  SHIP_OWNER
  PARTNER
  SUPPLIER
  MAINTENANCE
  ACCOUNTING_TAX
  PROSPECT
  OTHER
}

enum ContractStatus {
  DRAFT
  SIGNED
  BILLING_PENDING
  BILLING_DONE
  PAYMENT_PENDING
  PARTIAL_PAYMENT
  PAID
  CLOSED
  CANCELED
}

enum BillingStatus {
  PENDING
  ISSUED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ApprovalStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum MeetingStatus {
  SCHEDULED
  DONE
  MINUTES_DRAFT
  FOLLOW_UP
  COMPLETED
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaxInvoiceStatus {
  DRAFT
  ISSUING
  ISSUED
  FAILED
  CANCELED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String?        @map("password_hash")
  role          UserRole       @default(EMPLOYEE)
  status        RecordStatus   @default(ACTIVE)
  employeeId    String?
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  expenses      Expense[]      @relation("ExpenseCreatedBy")
  approvals     Expense[]      @relation("ExpenseApprovedBy")
  meetings      Meeting[]
  actionItems   ActionItem[]
  auditLogs     AuditLog[]
  notifications Notification[]
  taxInvoices   TaxInvoice[]   @relation("TaxInvoiceCreatedBy")
  estimates     Estimate[]     @relation("EstimateCreatedBy")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Employee {
  id         String       @id @default(uuid())
  name       String
  role       String
  department String?
  baseSalary BigInt?
  joinedAt   DateTime
  resignedAt DateTime?
  status     RecordStatus @default(ACTIVE)
  phone      String?
  email      String?
  users      User[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Client {
  id             String            @id @default(uuid())
  name           String
  clientType     ClientType        @default(OTHER)
  // 거래처는 실제로 지우지 않는다. 계약·세금계산서 이력이 남아야 하므로
  // 삭제 요청은 ARCHIVED 로 바꾸고 목록에서 감춘다.
  status         RecordStatus      @default(ACTIVE)
  businessNumber String?
  ceoName        String?
  phone          String?
  email          String?
  address        String?
  website        String?
  memo           String?
  tags           Json?
  contacts       ClientContact[]
  contracts      ProjectContract[]
  estimates      Estimate[]
  expenses       Expense[]
  taxInvoices    TaxInvoice[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model ClientContact {
  id                   String            @id @default(uuid())
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                 String
  position             String?
  department           String?
  mobile               String?
  phone                String?
  email                String?
  businessCardImageUrl String?
  ocrRawText           String?
  ocrConfidence        Decimal?
  memo                 String?
  meetingAttendees     MeetingAttendee[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model ProjectContract {
  id             String          @id @default(uuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])
  projectTitle   String
  contractAmount BigInt
  vatAmount      BigInt
  totalAmount    BigInt
  items          ContractItem[]
  estimates      Estimate[]
  billingStatus  BillingStatus   @default(PENDING)
  paymentStatus  PaymentStatus   @default(UNPAID)
  contractStatus ContractStatus  @default(DRAFT)
  contractedAt   DateTime?
  dueDate        DateTime?
  closedAt       DateTime?
  memo           String?
  taxInvoices    TaxInvoice[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// 계약 품목.
///
/// 계약 하나에 무엇을 얼마에 파는지가 담긴다. 개수 제한은 없다.
/// 계약의 contractAmount / vatAmount / totalAmount 는 이 품목들의 합계로 계산한다.
///
/// 세금계산서로 전개할 때 TaxInvoiceItem 으로 그대로 넘어간다.
model ContractItem {
  id           String          @id @default(uuid())
  contractId   String
  contract     ProjectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sortOrder    Int             @default(0)
  name         String
  spec         String?
  unit         String?
  quantity     Decimal         @default(1) @db.Decimal(14, 2)
  unitPrice    BigInt          @default(0)
  supplyAmount BigInt          @default(0)
  vatAmount    BigInt          @default(0)
  taxType      TaxType         @default(TAXABLE)
  memo         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([contractId, sortOrder])
}

enum TaxType {
  TAXABLE
  ZERO_RATED
  EXEMPT
}

/// 견적 상태.
///
/// 실무에서 견적서는 계약보다 훨씬 자주 쓰이고, 대부분은 계약으로 이어지지 않는다.
/// 그래서 "보냈는지 / 성사됐는지" 를 계약과 따로 관리한다.
///
/// CONVERTED 는 이 견적이 계약으로 전개된 상태다 (contractId 가 채워진다).
enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

/// 견적서.
///
/// 그동안 견적서 화면은 브라우저 localStorage 에만 저장돼서
/// 다른 사람이 볼 수도, 지난 견적을 다시 찾을 수도 없었다.
/// 이제 DB 에 남기고, 성사되면 계약으로 그대로 전개한다.
///
/// 거래처가 아직 등록되지 않은 상대에게도 견적을 내야 하므로
/// clientId 는 선택이고, recipient 에 받는 곳 이름을 직접 적을 수 있다.
///
/// 공급자(우리 회사) 정보를 함께 저장하는 이유:
/// 주소나 대표자가 바뀌어도 예전에 보낸 견적서를 그때 모습 그대로 다시 인쇄해야 한다.
model Estimate {
  id                      String           @id @default(uuid())
  estimateNo              String           @unique
  title                   String
  clientId                String?
  client                  Client?          @relation(fields: [clientId], references: [id])
  recipient               String?
  reference               String?
  status                  EstimateStatus   @default(DRAFT)
  issuedAt                DateTime?
  validUntil              DateTime?
  validityNote            String?
  supplyAmount            BigInt           @default(0)
  vatAmount               BigInt           @default(0)
  totalAmount             BigInt           @default(0)
  otherContent            String?
  supplierNumber          String?
  supplierName            String?
  supplierRepresentative  String?
  supplierAddress         String?
  supplierPhone           String?
  supplierEmail           String?
  memo                    String?
  contractId              String?
  contract                ProjectContract? @relation(fields: [contractId], references: [id])
  createdById             String?
  createdBy               User?            @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  items                   EstimateItem[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([clientId])
  @@index([status, issuedAt])
}

/// 견적 품목.
///
/// section 은 견적서의 "부문" 제목이다 (예: 용역 범위 / 유지보수).
/// 부문을 별도 표로 두지 않고 품목에 이름을 달아 묶는다 —
/// 부문은 순서와 제목만 있으면 되고, 표가 하나 더 늘면 전개할 때만 복잡해진다.
model EstimateItem {
  id           String   @id @default(uuid())
  estimateId   String
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section      String?
  sortOrder    Int      @default(0)
  name         String
  spec         String?
  unit         String?
  quantity     Decimal  @default(1) @db.Decimal(14, 2)
  unitPrice    BigInt   @default(0)
  supplyAmount BigInt   @default(0)
  vatAmount    BigInt   @default(0)
  taxType      TaxType  @default(TAXABLE)
  memo         String?

  @@index([estimateId, sortOrder])
}


model Expense {
  id              String         @id @default(uuid())
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  expenseCategory String
  amount          BigInt
  vatAmount       BigInt         @default(0)
  totalAmount     BigInt
  paymentMethod   String
  approvalStatus  ApprovalStatus @default(DRAFT)
  receiptImageUrl String?
  geminiAnalysis  String?
  spentAt         DateTime
  createdById     String?
  createdBy       User?          @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TaxInvoice {
  id                  String           @id @default(uuid())
  clientId            String?
  client              Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contractId          String?
  contract            ProjectContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdById         String?
  createdBy           User?            @relation("TaxInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mgtKey              String           @unique
  issueDirection      Int              @default(1)
  taxInvoiceType      Int              @default(1)
  taxType             Int              @default(1)
  taxCalcType         Int              @default(1)
  purposeType         Int              @default(2)
  writeDate           String
  invoicerCorpNum     String
  invoicerTaxRegId    String?
  invoicerCorpName    String
  invoicerCeoName     String
  invoicerAddress     String
  invoicerBizClass    String?
  invoicerBizType     String?
  invoicerContactId   String?
  invoicerContactName String?
  invoicerTel         String?
  invoicerHp          String?
  invoicerEmail       String?
  invoiceeCorpNum     String
  invoiceeTaxRegId    String?
  invoiceeCorpName    String
  invoiceeCeoName     String
  invoiceeAddress     String
  invoiceeBizClass    String?
  invoiceeBizType     String?
  invoiceeContactName String?
  invoiceeTel         String?
  invoiceeHp          String?
  invoiceeEmail       String?
  cash                String?
  chkBill             String?
  note                String?
  credit              String?
  remark1             String?
  remark2             String?
  remark3             String?
  sendSms             Boolean          @default(false)
  forceIssue          Boolean          @default(false)
  mailTitle           String?
  amountTotal         BigInt
  taxTotal            BigInt
  totalAmount         BigInt
  provider            String           @default("mock")
  providerResultCode  Int?
  providerMessage     String?
  providerStatus      Int?
  invoiceKey          String?
  approvalNumber      String?
  issuedAt            DateTime?
  payload             Json
  status              TaxInvoiceStatus @default(DRAFT)
  items               TaxInvoiceItem[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status, writeDate])
  @@index([clientId])
}

model TaxInvoiceItem {
  id             String     @id @default(uuid())
  taxInvoiceId   String
  taxInvoice     TaxInvoice @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)
  purchaseDate   String
  name           String
  information    String?
  chargeableUnit String
  unitPrice      String
  amount         BigInt
  tax            BigInt
  description    String?
  sortOrder      Int        @default(0)
}

model Meeting {
  id              String            @id @default(uuid())
  title           String
  meetingType     String
  status          MeetingStatus     @default(SCHEDULED)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id])
  contractId      String?
  contract        ProjectContract?  @relation(fields: [contractId], references: [id])
  calendarEventId String?           @unique
  calendarEvent   CalendarEvent?    @relation(fields: [calendarEventId], references: [id])
  location        String?
  startedAt       DateTime
  endedAt         DateTime?
  agenda          String?
  minutes         String?
  geminiSummary   String?
  createdById     String?
  createdBy       User?             @relation(fields: [createdById], references: [id])
  attendees       MeetingAttendee[]
  actionItems     ActionItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MeetingAttendee {
  id           String         @id @default(uuid())
  meetingId    String
  meeting      Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String?
  contactId    String?
  contact      ClientContact? @relation(fields: [contactId], references: [id])
  attendeeName String?
  attendeeType String
}

model ActionItem {
  id          String       @id @default(uuid())
  meetingId   String?
  meeting     Meeting?     @relation(fields: [meetingId], references: [id])
  title       String
  description String?
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id])
  dueDate     DateTime?
  status      ActionStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CalendarEvent {
  id            String           @id @default(uuid())
  googleEventId String?          @unique
  title         String
  category      String
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      ProjectContract? @relation(fields: [contractId], references: [id])
  meeting       Meeting?
  startTime     DateTime
  endTime       DateTime
  isAllDay      Boolean          @default(false)
  description   String?
  syncStatus    String           @default("LOCAL_ONLY")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model GoogleCalendarConnection {
  id                    String    @id @default("primary")
  accountEmail          String
  calendarId            String    @default("primary")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?
  lastSyncedAt          DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Attachment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String?
  fileSize   BigInt?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model DailyManagementReport {
  id             String   @id @default(uuid())
  reportDate     DateTime @unique
  geminiBriefing String
  sourceSnapshot Json?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Notification {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  body             String
  notificationType String
  targetUrl        String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
}
